{
    "name": "Add opencode to devcontainer",
    "id": "opencode",
    "version": "1.1.0",
    "description": "Добавляем в devcontainer агента opencode последней версии",
    "options": {
        "version": {
            "type": "string",
            "proposals": ["1.18.1", "latest"],
            "default": "latest",
            "description": "Укажите версию для установки"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/node"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "sst-dev.opencode"
            ]
        }
    },
	"mounts": [
        {
        "source": "opencode-config",
        "target": "/home/vscode/.config/opencode",
        "type": "volume"
        }
    ],
    "onCreateCommand": "sudo chown 1000:1000 -R /home/vscode/.config/opencode"
}
