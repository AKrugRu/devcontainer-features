{
    "name": "Add opencode to devcontainer",
    "id": "opencode",
    "version": "1.1.1",
    "description": "Добавляем в devcontainer агента opencode последней версии",
    "options": {
        "version": {
            "type": "string",
            "proposals": ["1.18.1", "latest"],
            "default": "latest",
            "description": "Укажите версию для установки"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/node"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "sst-dev.opencode"
            ]
        }
    },
    "mounts": [
        {
            "source": "opencode-config",
            "target": "$_REMOTE_USER_HOME/.config/opencode",
            "type": "volume"
        }
    ],
    "onCreateCommand": "sudo chown -R \"$(id -u):$(id -g)\" \"$_REMOTE_USER_HOME/.config/opencode\""
}
