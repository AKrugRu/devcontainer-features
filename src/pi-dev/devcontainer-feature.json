{
    "name": "Add pi.dev agent to devcontainer",
    "id": "pi-dev",
    "version": "1.1.1",
    "description": "Добавляем в devcontainer агента pi.dev",
    "options": {
        "version": {
            "type": "string",
            "proposals": ["0.82.1", "latest"],
            "default": "latest",
            "description": "Укажите версию для установки"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/node"
    ],
    "mounts": [
        {
            "source": "pi-config",
            "target": "$_REMOTE_USER_HOME/.pi/agent",
            "type": "volume"
        }
    ],
    "onCreateCommand": "sudo chown -R \"$(id -u):$(id -g)\" \"$_REMOTE_USER_HOME/.pi/agent\""
}
